#!/usr/bin/env bash
set -euo pipefail

# Resolve the installed symlink back to this clone, including relative links.
source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd -- "$(dirname -- "$source_path")" && pwd -P)"
  source_path="$(readlink "$source_path")"
  [[ "$source_path" = /* ]] || source_path="$source_dir/$source_path"
done
repo_dir="$(cd -- "$(dirname -- "$source_path")/../.." && pwd -P)"
if ! command -v node >/dev/null 2>&1; then
  printf 'git-tidy requires Node.js 24 or later.\n' >&2
  exit 1
fi
node -e 'if (Number(process.versions.node.split(".")[0]) < 24) process.exit(1)' || {
  printf 'git-tidy requires Node.js 24 or later.\n' >&2
  exit 1
}
exec node "$repo_dir/tools/git-tidy/src/cli.ts" "$@"
